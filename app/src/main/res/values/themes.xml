<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with NoActionBar for a modern, full-screen player look -->
    <style name="Theme.MaetPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1E40AF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorSecondaryVariant">#0284C7</item>
        <item name="colorOnSecondary">#000000</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
